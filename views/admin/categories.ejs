<%- include('./partials/header.ejs') %>
<section class="content-main">
    <div class="content-header">
        <div>
            <h2 class="content-title card-title">Categories</h2>
            <p>Add, edit, delete, list, or unlist a category</p>
        </div>
        <div>
            <input type="text" placeholder="Search Categories" class="form-control bg-white" />
        </div>
    </div>

    <!-- Category Form -->
    <div class="card">
        <div class="card-body">
            <% if (message && message.success) { %>
                <div class="alert alert-success"><%= message.success %></div>
            <% } %>
            <div class="row">
                <% if (message.error) { %>
                 <div class="alert alert-danger"><%= message.error %></div>
                <% } %>
                <div class="col-md-3">
                    <form action="/admin/categories" method="POST" onsubmit="return validateForm()">
                        <div class="mb-3">
                            <label for="category_name" class="form-label">Name</label>
                            <div id="nameError" style="color: red;"></div>
                            <input type="text" placeholder="Category Name" class="form-control" id="category_name" name="name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea id="description" placeholder="Category Description" class="form-control" name="description"></textarea>
                            <div id="descriptionError" style="color: red;"></div>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Add Category</button>
                        </div>
                    </form>
                </div>

                <!-- Category Management Table -->
                <div class="col-md-9">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <% if (categories) { %>
                                <tbody>
                                    <% categories.forEach(category => { %>
                                        <tr>
                                            <td><b><%= category.name %></b></td>
                                            <td><%= category.description %></td>
                                            <td>
                                                <span class="badge <%= category.isListed ? 'bg-success' : 'bg-danger' %>">
                                                    <%= category.isListed ? "Listed" : 'UnListed' %>
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <div class="dropdown">
                                                    <a href="#" data-bs-toggle="dropdown" class="btn btn-light rounded btn-sm">
                                                        <i class="material-icons md-more_horiz"></i>
                                                    </a>
                                                    <div class="dropdown-menu">
                                                        <form action="/admin/categories/edit/<%= category._id %>" method="GET">
                                                            <button type="submit" class="dropdown-item">Edit</button>
                                                        </form>
                                                        <form action="/admin/categories/islist/<%= category._id %>" method="POST">
                                                            <button type="submit" class="dropdown-item"><%= category.isListed ? 'Unlist' : 'List' %></button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            <% } else {%>
                                <h1>no categories found add some categories</h1>
                            <% } %>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // Validation configuration for flexibility
    const validationRules = {
        name: {
            minLength: 3,
            maxLength: 50,
            pattern: /^[a-zA-Z0-9\s\-_&]+$/,
            errorMessages: {
                empty: "Category name cannot be empty.",
                length: "Category name must be between 3 and 50 characters.",
                pattern: "Category name can only contain letters, numbers, spaces, hyphens, underscores, or ampersands."
            }
        },
        description: {
            minLength: 10,
            maxLength: 500,
            errorMessages: {
                empty: "Description cannot be empty.",
                length: "Description must be between 10 and 500 characters."
            }
        }
    };

    function validateName() {
        const name = document.getElementById('category_name').value.trim();
        const nameError = document.getElementById('nameError');
        
        if (!name) {
            nameError.textContent = validationRules.name.errorMessages.empty;
            return false;
        }
        
        if (name.length < validationRules.name.minLength || name.length > validationRules.name.maxLength) {
            nameError.textContent = validationRules.name.errorMessages.length;
            return false;
        }
        
        if (!validationRules.name.pattern.test(name)) {
            nameError.textContent = validationRules.name.errorMessages.pattern;
            return false;
        }
        
        nameError.textContent = '';
        return true;
    }

    function validateDescription() {
        const description = document.getElementById('description').value.trim();
        const descriptionError = document.getElementById('descriptionError');
        
        if (!description) {
            descriptionError.textContent = validationRules.description.errorMessages.empty;
            return false;
        }
        
        if (description.length < validationRules.description.minLength || description.length > validationRules.description.maxLength) {
            descriptionError.textContent = validationRules.description.errorMessages.length;
            return false;
        }
        
        descriptionError.textContent = '';
        return true;
    }

    function validateForm() {
        const isNameValid = validateName();
        const isDescriptionValid = validateDescription();
        return isNameValid && isDescriptionValid;
    }

    // Real-time validation on input
    document.getElementById('category_name').addEventListener('input', validateName);
    document.getElementById('description').addEventListener('input', validateDescription);

    // Scroll to top on page load
    window.addEventListener('load', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });
</script>

<%- include('./partials/footer.ejs') %>